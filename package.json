{
  "name": "discord-infra",
  "version": "1.0.0",
  "description": "Declarative Discord Infrastructure as Code Manager",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "discord-infra": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "discord-infra": "bun run src/cli.ts",
    "plan": "bun run src/cli.ts plan",
    "apply": "bun run src/cli.ts apply",
    "validate": "bun run src/cli.ts validate",
    "export": "bun run src/cli.ts export",
    "verify": "bun run src/cli.ts verify",
    "wipe": "bun run src/cli.ts wipe",
    "wipe:all": "bun run src/cli.ts wipe --all",
    "wipe:roles": "bun run src/cli.ts wipe --roles-only",
    "wipe:emojis": "bun run src/cli.ts wipe --emojis-only",
    "clear": "bun run src/cli.ts clear",
    "preview": "bun run src/cli.ts preview",
    "preview:open": "bun run src/cli.ts preview --open",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
